+static void scene_node_clip_region(struct wlr_scene_node *node,
+		int x, int y, pixman_region32_t *region) {
+	while (node) {
+		if (node->clip_enabled) {
+			pixman_region32_translate(region, -x, -y);
+			pixman_region32_intersect(region, region, &node->clip);
+			pixman_region32_translate(region, x, y);
+		}
+		x -= node->x;
+		y -= node->y;
+		node = node->parent ? &node->parent->node : NULL;
+	}
+}
