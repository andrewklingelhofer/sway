+void wlr_scene_node_set_clip(struct wlr_scene_node *node,
+		const pixman_region32_t *clip) {
+	if (node->clip_enabled == (clip != NULL) &&
+			(!clip || pixman_region32_equal(&node->clip, clip))) {
+		return;
+	}
+	node->clip_enabled = clip != NULL;
+	if (clip) {
+		pixman_region32_copy(&node->clip, clip);
+	} else {
+		pixman_region32_clear(&node->clip);
+	}
+	// Updating visibility damages both the old and new exposed regions.
+	scene_node_update(node, NULL);
+}
